{% assign page_description = page.description | default: site.description %}
{% capture document_title %}{% if page.url == '/' or page.title == blank or page.title == 'blank' %}{{ site.title }}{% else %}{{ page.title }} | {{ site.title }}{% endif %}{% endcapture %}
{% assign canonical_url = page.url | replace: 'index.html', '' | absolute_url %}
{% assign website_id = '/' | absolute_url | append: '#website' %}
{% assign page_id = canonical_url | append: '#webpage' %}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{ document_title | strip | escape }}</title>
<meta name="description" content="{{ page_description | escape }}">
{% if page.keywords or site.keywords %}
  <meta name="keywords" content="{{ page.keywords | default: site.keywords | escape }}">
{% endif %}
{% if page.url == '/404.html' %}
  <meta name="robots" content="noindex, follow">
{% endif %}

{% if site.enable_google_verification %}
  <meta name="google-site-verification" content="{{ site.google_site_verification | escape }}">
  {% for token in site.additional_google_site_verifications %}
    <meta name="google-site-verification" content="{{ token | escape }}">
  {% endfor %}
{% endif %}
{% if site.enable_bing_verification %}
  <meta name="msvalidate.01" content="{{ site.bing_site_verification | escape }}">
{% endif %}

{% if site.serve_og_meta %}
  <meta property="og:site_name" content="{{ site.title | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ document_title | strip | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:description" content="{{ page_description | escape }}">
  <meta property="og:locale" content="{{ site.lang }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ document_title | strip | escape }}">
  <meta name="twitter:description" content="{{ page_description | escape }}">
  {% assign sharing_image = page.og_image | default: site.og_image %}
  {% if sharing_image %}
    <meta property="og:image" content="{{ sharing_image | absolute_url }}">
    <meta name="twitter:image" content="{{ sharing_image | absolute_url }}">
  {% endif %}
{% endif %}

{% if site.serve_schema_org and page.url != '/' and page.url != '/404.html' %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": {{ page_id | jsonify }},
      "name": {{ document_title | strip | jsonify }},
      "url": {{ canonical_url | jsonify }},
      "description": {{ page_description | jsonify }},
      "inLanguage": {{ site.lang | jsonify }},
      "isPartOf": { "@id": {{ website_id | jsonify }} }
    }
  </script>
{% endif %}
